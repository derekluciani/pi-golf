{
  "name": "pi-golf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A deterministic golf game implemented as a project-local Pi extension.",
  "exports": {
    ".": "./.pi/extensions/golf/index.ts",
    "./domain": "./.pi/extensions/golf/domain/index.ts",
    "./course-loader": "./.pi/extensions/golf/course-loader/index.ts",
    "./courses": "./.pi/extensions/golf/courses/index.ts",
    "./ui": "./.pi/extensions/golf/ui/index.ts"
  },
  "files": [
    ".pi/extensions/golf/index.ts",
    ".pi/extensions/golf/persistence/index.ts",
    ".pi/extensions/golf/domain/index.ts",
    ".pi/extensions/golf/domain/clock.ts",
    ".pi/extensions/golf/simulation/**",
    ".pi/extensions/golf/ui/**",
    "scripts/check-node-version.mjs",
    "scripts/patch-pi-brace-expansion.mjs",
    "README.md",
    ".pi/extensions/golf/course-loader/catalog.ts",
    ".pi/extensions/golf/course-loader/loading.ts",
    ".pi/extensions/golf/course-loader/minimal-course-play.ts",
    ".pi/extensions/golf/course-loader/selection.ts",
    ".pi/extensions/golf/course-loader/settings.ts",
    ".pi/extensions/golf/course-loader/ui.ts",
    ".pi/extensions/golf/course-loader/course.schema.json",
    ".pi/extensions/golf/course-loader/geometry.ts",
    ".pi/extensions/golf/course-loader/index.ts",
    ".pi/extensions/golf/course-loader/rasterizer.ts",
    ".pi/extensions/golf/course-loader/raw-parser.ts",
    ".pi/extensions/golf/course-loader/schema.ts",
    ".pi/extensions/golf/course-loader/snapshot.ts",
    ".pi/extensions/golf/course-loader/types.ts",
    ".pi/extensions/golf/course-loader/validation.ts",
    ".pi/extensions/golf/course-loader/warnings.ts",
    ".pi/extensions/golf/courses/index.ts",
    ".pi/extensions/golf/courses/preview-course.json",
    "docs/course-format.md",
    "docs/examples/minimal-course.json"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "prelint": "npm run check:node",
    "lint": "eslint .",
    "pretypecheck": "npm run check:node",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run check:node",
    "test": "vitest run",
    "postinstall": "node scripts/patch-pi-brace-expansion.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.15",
    "brace-expansion": "5.0.8",
    "eslint": "10.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "robust-predicates": "^3.0.2"
  }
}
